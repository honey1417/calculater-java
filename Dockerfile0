# ---------- Stage 1: Builder ----------
FROM eclipse-temurin:17-jdk as builder

WORKDIR /app

# Build-time environment variables
ARG NEXUS_USERNAME
ARG NEXUS_PASSWORD
ARG BUILD_TYPE=SNAPSHOT  # Accepts 'SNAPSHOT' or 'RELEASE'

# Set the correct JAR URL based on the build type
# Use shell logic in RUN to fetch the correct JAR
RUN if [ "$BUILD_TYPE" = "SNAPSHOT" ]; then \
      curl -u ${NEXUS_USERNAME}:${NEXUS_PASSWORD} \
      -o app.jar \
      "http://34.10.114.146:8081/repository/maven-artifacts-snapshots-repo/com/example/calculator/0.0.1-SNAPSHOT/calculator-0.0.1-SNAPSHOT.jar"; \
    else \
      curl -u ${NEXUS_USERNAME}:${NEXUS_PASSWORD} \
      -o app.jar \
      "http://34.10.114.146:8081/repository/maven-artifacts-release-repo/com/example/calculator/1.0.0/calculator-1.0.0.jar"; \
    fi

# ---------- Stage 2: Final Image ----------
FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=builder /app/app.jar .

EXPOSE 8081

CMD ["java", "-jar", "app.jar"]
